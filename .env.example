# Copy to .env (never commit .env) and change the values.

# --- Databases -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me

# --- Message broker --------------------------------------------------------
RABBITMQ_USER=flashtix
RABBITMQ_PASSWORD=change-me

# --- Object storage for ticket PDFs ----------------------------------------
# S3 bucket created at startup by ticket-files-init.
TICKET_BUCKET=tickets

# --- Payment gateway mock (INF-5) ------------------------------------------
# The real legacy gateway answers in up to 15 s. Keep these defaults to develop
# against realistic latency; raise the rates to demo failures and retries.
MOCK_LATENCY_MIN_MS=200
MOCK_LATENCY_MAX_MS=15000
MOCK_DECLINE_RATE=0.05
MOCK_ERROR_RATE=0.05
MOCK_TIMEOUT_RATE=0.02
