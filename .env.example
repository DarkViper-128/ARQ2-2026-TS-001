# Copy to .env (never commit .env) and change the values.

# --- Databases -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me

# --- Message broker --------------------------------------------------------
RABBITMQ_USER=flashtix
RABBITMQ_PASSWORD=change-me

# --- Object storage for ticket PDFs ----------------------------------------
# S3 bucket created at startup by ticket-files-init.
TICKET_BUCKET=tickets

# --- Payment gateway mock (INF-5) ------------------------------------------
# The real legacy gateway answers in up to 15 s. Keep these defaults to develop
# against realistic latency; raise the rates to demo failures and retries.
MOCK_LATENCY_MIN_MS=200
MOCK_LATENCY_MAX_MS=15000
MOCK_DECLINE_RATE=0.05
MOCK_ERROR_RATE=0.05
MOCK_TIMEOUT_RATE=0.02

# --- Virtual queue (WR-3, WR-4) -------------------------------------------
# Shared by the Waiting Room (signs the admission token) and the Reservation
# Service (checks it on POST /holds). Any long random string.
ADMISSION_TOKEN_SECRET=change-me
# A new batch of ADMISSION_BATCH_SIZE fans is admitted every ADMISSION_INTERVAL_MS.
ADMISSION_BATCH_SIZE=500
ADMISSION_INTERVAL_MS=10000

# --- Payment Worker (PAY-3) -------------------------------------------------
# Wait between gateway attempts, in ms (spec.md section 7: 2 s, 10 s, 30 s).
PAYMENT_RETRY_DELAYS_MS=2000,10000,30000

# --- Ticket Service and Notification Worker (feature F5) --------------------
# Signs the QR payload of every ticket (HMAC). Any long random string.
TICKET_QR_SECRET=change-me
# Host the BROWSER of the fan uses to reach the S3 bucket; the download link is signed for it.
S3_PUBLIC_ENDPOINT=http://localhost:9090
# From header of the emails.
MAIL_FROM=FlashTix <no-reply@flashtix.test>

# --- Identity provider (Keycloak) ------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Observability (Phase 4) -----------------------------------------------
# Grafana admin credentials.
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=change-me
